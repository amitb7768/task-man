# taskman server configuration — copy to `.env` and fill in real values.
#   cp .env.example .env
#
# The Go server reads plain environment variables (it does NOT auto-load this
# file). To apply it, source it into your shell before running the server:
#   set -a; source .env; set +a
#   make run          # or: ./taskman-bin
# Or inline for one run:
#   env $(grep -v '^#' .env | xargs) ./taskman-bin
# For a launchd/systemd deploy, copy these into the service's env block instead
# (see docs/DEPLOYMENT.md). Never commit your filled-in .env — it's gitignored.

# HTTP port. Binds all interfaces, so the server is reachable across the LAN.
PORT=8484

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# Database name. Use a throwaway name (e.g. taskman_dev) for local testing so
# you don't touch real data.
MONGO_DB=taskman

# First-admin bootstrap. On startup, if no login-enabled account exists yet,
# the server creates an ADMIN with this email. Idempotent afterward (no-op once
# any login-enabled user exists). Leave blank if the admin already exists.
ADMIN_EMAIL=you@company.com

# Optional seed password for that first admin. If left blank, the server
# generates a random one and prints it to the log ONCE on that boot. Either way
# the admin must change it on first login.
ADMIN_PASSWORD=
